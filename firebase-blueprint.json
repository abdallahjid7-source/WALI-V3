{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wali Songhai Firebase Blueprint",
  "description": "Schéma Firestore pour le jeu traditionnel Wali Songhaï (partages de parties multijoueur, chat éphémère et modération)",
  "entities": {
    "games": {
      "path": "games/{gameId}",
      "description": "Parties multijoueur du Wali",
      "properties": {
        "code": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "status": { "type": "string", "enum": ["waiting", "ongoing", "finished"] },
        "creatorUid": { "type": "string" },
        "creatorPlayer": { "type": "string" },
        "opponentUid": { "type": "string" },
        "opponentPlayer": { "type": "string" },
        "players": { "type": "array", "items": { "type": "string" } },
        "gameStateJson": { "type": "string" },
        "lastMoveAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "winner": { "type": "string" },
        "abandonedBy": { "type": "string" }
      },
      "subcollections": {
        "messages": {
          "path": "games/{gameId}/messages/{messageId}",
          "description": "Messages éphémères du chat de la partie",
          "properties": {
            "senderRole": { "type": "string" },
            "senderUid": { "type": "string" },
            "text": { "type": "string", "maxLength": 200 },
            "type": { "type": "string" },
            "timestamp": { "type": "number" }
          }
        }
      }
    },
    "reports": {
      "path": "reports/{reportId}",
      "description": "Signalements de comportement ou d'abus",
      "properties": {
        "reporterUid": { "type": "string" },
        "reason": { "type": "string", "maxLength": 300 },
        "gameCode": { "type": "string" },
        "reportedUid": { "type": "string" },
        "timestamp": { "type": "number" }
      }
    }
  }
}
